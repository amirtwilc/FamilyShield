DATABASE_URL=postgres://user:pass@host/db?sslmode=require
TEST_DATABASE_URL=postgres://user:pass@host/familyshield_test?sslmode=require
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Firebase Authentication and FCM should use the same project.
FIREBASE_PROJECT_ID=familyshield-production
FIREBASE_SERVICE_ACCOUNT_JSON=
# Require Play Integrity App Check for Firebase-authenticated API requests.
FIREBASE_REQUIRE_APP_CHECK=true
# Set to the exact UTC instant 30 days after deploying the dual-auth backend.
LEGACY_AUTH_CUTOFF_AT=
# Deprecated alias; FIREBASE_SERVICE_ACCOUNT_JSON is preferred.
FCM_SERVICE_ACCOUNT_JSON=
LOW_BATTERY_THRESHOLD=15
LOW_BATTERY_COOLDOWN_MIN=60
OFFLINE_THRESHOLD_MIN=30
PAIRING_CODE_TTL_MIN=10
MAX_LOCATION_BATCH=200
LOCATION_MAX_FUTURE_MIN=10
LOCATION_MAX_BACKFILL_DAYS=90
CRON_SECRET=change-me-cron
MESSAGE_ENCRYPTION_KEY=Y2hhbmdlLW1lLTMyLWJ5dGUtbWVzc2FnZS1rZXkhISE=
MESSAGE_RETENTION_DAYS=365
PG_POOL_MAX=5
# Set only when deploying behind a proxy that replaces/appends X-Forwarded-For.
# Vercel is detected automatically. Railway deployments should set this true.
TRUST_PROXY=false
