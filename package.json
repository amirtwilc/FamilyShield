{
  "name": "familyshield-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test",
    "test:auth-emulator": "firebase emulators:exec --only auth --project demo-familyshield \"vitest run test/api/firebase-auth-emulator.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "node scripts/apply-dev-schema.mjs",
    "db:prod:setup": "node scripts/apply-production-schema.mjs",
    "db:check": "node scripts/check-production-schema.mjs",
    "db:encrypt-messages": "node scripts/encrypt-message-history.mjs",
    "auth:preflight": "node scripts/check-firebase-auth-migration.mjs",
    "auth:provision": "node scripts/provision-firebase-auth-users.mjs",
    "auth:provision:apply": "node scripts/provision-firebase-auth-users.mjs --apply"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@neondatabase/serverless": "^0.10.0",
    "argon2": "^0.41.0",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "13.10.0",
    "jose": "^5.9.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-dist": "^5.17.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.10",
    "firebase-tools": "^15.24.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    },
    "google-gax": {
      "rimraf": "6.1.3"
    },
    "rimraf": {
      "glob": "13.0.6"
    },
    "glob": {
      "minimatch": "10.2.6"
    },
    "minimatch": {
      "brace-expansion": "5.0.8"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    }
  }
}
